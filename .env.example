# ===============================================================
# 🩺 CI-Doctor (MERN Stack + Groq AI LPU + Live GitHub) Config
# ===============================================================

# Server Port (Default: 5000)
PORT=5000

# ---------------------------------------------------------------
# 1. ⚡ Groq AI Configuration (Ultra-Fast LPU Inference)
# ---------------------------------------------------------------
# Get a free Groq API key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------
# 2. 🐙 Live GitHub Integration (Required for Real Pull Requests)
# ---------------------------------------------------------------
# Generate a Classic GitHub Personal Access Token:
# Go to: https://github.com/settings/tokens
# Check: 'repo' (Full control) & 'workflow'
GITHUB_TOKEN=

# Target repository where branches and PRs will be created:
# Format: your-github-username/your-repository-name
GITHUB_REPO=

# ---------------------------------------------------------------
# 3. 🗄️ Database (Optional: In-memory persistence is active by default)
# ---------------------------------------------------------------
# Leave empty for zero-setup in-memory database
MONGODB_URI=

# ---------------------------------------------------------------
# 4. 📡 Webhook Relay (Optional: for local GitHub Actions webhooks)
# ---------------------------------------------------------------
# Free channel at https://smee.io/
SMEE_URL=
