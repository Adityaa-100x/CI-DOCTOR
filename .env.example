# ===============================================================
# 🩺 CI-Doctor (MERN Stack) Environment Configuration
# ===============================================================

# Server Port (Default: 5000)
PORT=5000

# MongoDB Connection (Optional: in-memory persistence is used if empty)
# Example: mongodb://localhost:27017/ci-doctor
MONGODB_URI=

# GitHub Integration (Optional for offline simulation, required for real GitHub PRs)
# Generate a classic token with 'repo' and 'workflow' permissions:
# https://github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_REPO=your-github-username/your-repo

# AI Reasoning Engine (Optional: built-in deterministic Viva engine runs if empty)
# Get a free Gemini API key: https://aistudio.google.com/
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash

# Smee.io Webhook Relay (Optional: for receiving live GitHub webhooks locally)
# https://smee.io/ -> "Start a new channel"
SMEE_URL=
